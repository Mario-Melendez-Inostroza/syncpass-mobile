<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de la app se respalda en la nube ni se transfiere entre dispositivos: la base local y los
     tokens son datos de trabajo (y el caso prohíbe conservar copias fuera del equipo). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Caso 3.3: la cámara lee el QR de cada asistente. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Caso 3.3: ubicación REFERENCIAL de la marcación. Es opcional: si se niega, la marcación se guarda igual. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Caso 3.3: avisos visuales inmediatos (confirmaciones, pendientes de sincronizar). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sin cámara o GPS la app sigue sirviendo: se puede elegir al asistente de una lista. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".SyncPassApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncPass">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SyncPass"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
